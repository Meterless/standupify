{
  "name": "standupify",
  "private": true,
  "version": "1.0.0",
  "description": "The open-source comedy special studio. Nightshift writes it, ComfyUI shoots it.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "node scripts/start.mjs",
    "dev": "vite",
    "demo": "node scripts/start.mjs --demo",
    "mock": "node scripts/mock-engines.mjs",
    "setup:comfy": "node scripts/setup-comfy.mjs",
    "export:workflows": "node --experimental-strip-types --no-warnings scripts/export-workflows.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:backstage && npm run test:tv && npm run test:night-shift && npm run test:provenance",
    "test:backstage": "node scripts/backstage.test.mjs",
    "test:tv": "node --experimental-strip-types --no-warnings scripts/test-tv-programming.mjs && node --experimental-strip-types --no-warnings scripts/test-tv-playback.mjs",
    "test:night-shift": "node --experimental-vm-modules --no-warnings scripts/test-night-shift-unit.mjs",
    "test:provenance": "node --experimental-strip-types --no-warnings --test scripts/test-provenance.mjs",
    "test:station": "node scripts/test-night-shift.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "landing": "node scripts/build-landing.mjs",
    "soak": "node scripts/soak.mjs",
    "receipts": "node --experimental-strip-types --no-warnings scripts/receipts.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-fs": "^2.0.0",
    "@tauri-apps/plugin-http": "^2.0.0",
    "@tauri-apps/plugin-opener": "^2.0.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  },
  "engines": {
    "node": ">=18.17"
  }
}
