{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Standupify",
  "version": "0.1.0",
  "identifier": "io.sitcomify.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Standupify",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Entertainment",
    "shortDescription": "Cast a comedian, shoot the special — on your own GPU.",
    "longDescription": "Standupify casts stand-up comedians, writes and grades their sets with Nightshift, and shoots and animates the special with ComfyUI — all on your own GPU.",
    "copyright": "© 2026 Standupify"
  }
}
